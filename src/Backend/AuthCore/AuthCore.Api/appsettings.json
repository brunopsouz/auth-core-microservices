{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "authcore-api",
    "ServiceNamespace": "auth-core-microservices",
    "OtlpEnabled": false,
    "ConsoleExporterEnabled": false,
    "TraceSamplingRatio": 0.1,
    "ExcludeHealthChecks": true,
    "RequestLogging": {
      "Enabled": true,
      "LogSuccessfulRequests": false,
      "LogClientErrors": false,
      "LogRateLimitedRequests": true,
      "LogServerErrors": true,
      "LogHealthChecks": false,
      "IncludeUserId": false,
      "SlowRequestThresholdMilliseconds": 1000
    }
  },
  "AllowedHosts": "*"
}

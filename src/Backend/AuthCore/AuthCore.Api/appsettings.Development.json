{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "authcore-api",
    "ServiceNamespace": "auth-core-microservices",
    "OtlpEnabled": false,
    "ConsoleExporterEnabled": false,
    "TraceSamplingRatio": 1.0,
    "ExcludeHealthChecks": true
  },
  "HealthChecks": {
    "DependencyTimeoutSeconds": 5
  },
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Database": {
    "Migrations": {
      "AutoMigrateOnStartup": true,
      "EnsureDatabaseCreated": true,
      "AdminDatabase": "postgres"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "authcore-dev",
      "Audience": "authcore-dev",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 5,
      "RefreshTokenLifetimeDays": 7,
      "ClockSkewSeconds": 60
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/api/auth/external/google/callback"
    },
    "DefaultReturnUrl": "http://localhost:5173",
    "AllowedReturnUrls": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "authcore:dev"
  },
  "DataProtection": {
    "ApplicationName": "AuthCore",
    "KeyName": "data-protection-keys",
    "RequireCertificate": false,
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  "Auth": {
    "Cookie": {
      "SessionCookieName": "sid",
      "AccessTokenCookieName": "at",
      "Secure": false
    },
    "Csrf": {
      "SigningKey": "",
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ]
    },
    "LoginRateLimit": {
      "MaxAttemptsPerIp": 20,
      "MaxAttemptsPerEmail": 5,
      "WindowMinutes": 5
    },
    "Session": {
      "TtlMinutes": 120,
      "SlidingTtl": true,
      "LastSeenUpdateIntervalSeconds": 60
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "Exchange": "notification.requests",
    "RoutingKey": "notification.email.requested",
    "Queue": "notification.email.requests",
    "DeadLetterQueue": "notification.email.requests.dlq"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "MaxAttempts": 5,
    "LeaseDurationSeconds": 30
  }
}

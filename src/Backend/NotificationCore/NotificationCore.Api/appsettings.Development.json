{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "notificationcore-api",
    "ServiceNamespace": "auth-core-microservices",
    "OtlpEnabled": false,
    "ConsoleExporterEnabled": false,
    "TraceSamplingRatio": 1.0,
    "ExcludeHealthChecks": true
  },
  "HealthChecks": {
    "DependencyTimeoutSeconds": 5
  },
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Database": {
    "Migrations": {
      "AutoMigrateOnStartup": true,
      "EnsureDatabaseCreated": true,
      "AdminDatabase": "postgres"
    }
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "Exchange": "notification.requests",
    "RoutingKey": "notification.email.requested",
    "Queue": "notification.email.requests",
    "DeadLetterQueue": "notification.email.requests.dlq"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseTls": true,
    "SenderEmail": "",
    "SenderName": "",
    "TimeoutSeconds": 30
  },
  "NotificationDispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "RetryDelaySeconds": 300,
    "ProcessingTimeoutSeconds": 900
  }
}

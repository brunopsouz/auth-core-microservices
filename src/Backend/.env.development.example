# APIs
AUTHCORE_API_PORT=8081
NOTIFICATIONCORE_API_PORT=8082
GATEWAY_API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Observability / OpenTelemetry Collector
OBSERVABILITY__OTLPENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_PROMETHEUS_PORT=8889
OTEL_COLLECTOR_HEALTH_PORT=13133
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
JAEGER_VERSION=2.19.0
JAEGER_UI_PORT=16686
LOKI_VERSION=3.5.7
LOKI_HTTP_PORT=3100
LOKI_RETENTION_PERIOD=168h

# PostgreSQL - AuthCore
AUTHCORE_POSTGRES_PORT=5432
AUTHCORE_POSTGRES_DB=auth_core
AUTHCORE_POSTGRES_USER=
AUTHCORE_POSTGRES_PASSWORD=
AUTHCORE_DATABASE_MIGRATIONS_AUTOMIGRATEONSTARTUP=true
AUTHCORE_DATABASE_MIGRATIONS_ENSUREDATABASECREATED=true

# PostgreSQL - NotificationCore
NOTIFICATIONCORE_POSTGRES_PORT=5433
NOTIFICATIONCORE_POSTGRES_DB=notification_core
NOTIFICATIONCORE_POSTGRES_USER=
NOTIFICATIONCORE_POSTGRES_PASSWORD=
NOTIFICATIONCORE_DATABASE_MIGRATIONS_AUTOMIGRATEONSTARTUP=true
NOTIFICATIONCORE_DATABASE_MIGRATIONS_ENSUREDATABASECREATED=true

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS__CONNECTIONSTRING=localhost:6379,password=,abortConnect=false
REDIS__KEYPREFIX=authcore:dev

# Data Protection compartilhado
DATAPROTECTION__APPLICATIONNAME=AuthCore
DATAPROTECTION__KEYNAME=data-protection-keys
DATAPROTECTION__REQUIRECERTIFICATE=false
DATAPROTECTION__CERTIFICATEPATH=
DATAPROTECTION__CERTIFICATEPASSWORD=

# Proxy/Gateway confiavel no network Docker local
REVERSEPROXY__KNOWNNETWORKS__0=172.28.0.0/16
REVERSEPROXY__FORWARDLIMIT=2

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__VIRTUALHOST=/
RABBITMQ__USERNAME=
RABBITMQ__PASSWORD=
RABBITMQ__EXCHANGE=notification.requests
RABBITMQ__ROUTINGKEY=notification.email.requested
RABBITMQ__QUEUE=notification.email.requests
RABBITMQ__DEADLETTERQUEUE=notification.email.requests.dlq

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=no-reply@example.test
SMTP_SENDER_NAME=AuthCore Local
SMTP_TIMEOUT_SECONDS=30

# AuthCore local
CONNECTIONSTRINGS__POSTGRESQL=Host=localhost;Port=5432;Database=auth_core;Username=;Password=;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=30;Timeout=10;Command Timeout=30;Application Name=AuthCore

# JWT
AUTHENTICATION__JWT__ISSUER=authcore-dev
AUTHENTICATION__JWT__AUDIENCE=authcore-dev
AUTHENTICATION__JWT__SIGNINGKEY=
AUTHENTICATION__JWT__ACCESSTOKENLIFETIMEMINUTES=5
AUTHENTICATION__JWT__REFRESHTOKENLIFETIMEDAYS=7
AUTHENTICATION__JWT__CLOCKSKEWSECONDS=60

# Google external authentication
AUTHENTICATION__GOOGLE__CLIENTID=
AUTHENTICATION__GOOGLE__CLIENTSECRET=
AUTHENTICATION__GOOGLE__CALLBACKPATH=/api/auth/external/google/callback
AUTHENTICATION__DEFAULTRETURNURL=http://localhost:5173
AUTHENTICATION__ALLOWEDRETURNURLS__0=http://localhost:3000
AUTHENTICATION__ALLOWEDRETURNURLS__1=http://127.0.0.1:3000
AUTHENTICATION__ALLOWEDRETURNURLS__2=http://localhost:5173
AUTHENTICATION__ALLOWEDRETURNURLS__3=http://127.0.0.1:5173

# Browser authentication cookies / CSRF
AUTH__COOKIE__SESSIONCOOKIENAME=sid
AUTH__COOKIE__ACCESSTOKENCOOKIENAME=at
AUTH__CSRF__SIGNINGKEY=
AUTH__CSRF__ALLOWEDORIGINS__0=http://localhost:3000
AUTH__CSRF__ALLOWEDORIGINS__1=http://127.0.0.1:3000
AUTH__CSRF__ALLOWEDORIGINS__2=http://localhost:5173
AUTH__CSRF__ALLOWEDORIGINS__3=http://127.0.0.1:5173

# Workers
OUTBOX__ENABLED=true
OUTBOX__BATCHSIZE=20
OUTBOX__POLLINGINTERVALSECONDS=10
OUTBOX__MAXATTEMPTS=5
NOTIFICATIONCORE_RABBITMQ_CONSUMER_ENABLED=true
NOTIFICATIONCORE_DISPATCHER_ENABLED=true
NOTIFICATIONCORE_DISPATCHER_BATCH_SIZE=20
NOTIFICATIONCORE_DISPATCHER_POLLING_INTERVAL_SECONDS=10
NOTIFICATIONCORE_DISPATCHER_RETRY_DELAY_SECONDS=300
NOTIFICATIONCORE_DISPATCHER_PROCESSING_TIMEOUT_SECONDS=900
